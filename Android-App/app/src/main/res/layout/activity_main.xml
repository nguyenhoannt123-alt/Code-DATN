<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">


        <!-- ================================================= -->
        <!-- IP CŨ - GIỮ ID ĐỂ JAVA KHÔNG LỖI -->
        <!-- ================================================= -->

        <EditText
            android:id="@+id/edtEspIp"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnSaveIp"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />


        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SMART DOOR"
            android:textColor="#111827"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Hệ thống cửa khóa thông minh"
            android:textColor="#6B7280"
            android:textSize="14sp" />


        <!-- ================================================= -->
        <!-- CONNECTION STATUS -->
        <!-- ================================================= -->


        <!-- ================================================= -->
        <!-- DOOR MAIN CARD -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvConnection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_status"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:text="●  ĐANG TÌM ESP32..."
            android:textColor="#B45309"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/cardDoor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_main_card"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="26dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">


            <!-- ICON KHÓA / MỞ -->

            <TextView
                android:id="@+id/tvDoorIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒"
                android:textSize="54sp" />


            <!-- TRẠNG THÁI CỬA -->

            <TextView
                android:id="@+id/tvDoorStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="CỬA ĐANG KIỂM TRA..."
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />


            <!-- IP ESP32 -->

            <TextView
                android:id="@+id/tvIp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="IP ESP32: Đang tìm..."
                android:textColor="#DDE7FF"
                android:textSize="14sp" />


            <!-- ================================================= -->
            <!-- OPEN / LOCK BUTTON -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">


                <Button
                    android:id="@+id/btnOpenDoor"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_weight="1"
                    android:backgroundTint="#FFFFFF"
                    android:text="🔓  MỞ CỬA"
                    android:textAllCaps="false"
                    android:textColor="#2563EB"
                    android:textSize="15sp"
                    android:textStyle="bold" />


                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />


                <Button
                    android:id="@+id/btnLockDoor"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_weight="1"
                    android:backgroundTint="#172554"
                    android:text="🔒  KHÓA CỬA"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- SYSTEM STATUS -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="TRẠNG THÁI HỆ THỐNG"
            android:textColor="#111827"
            android:textSize="16sp"
            android:textStyle="bold" />


        <!-- ================================================= -->
        <!-- SENSOR CARDS -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">


            <!-- ================================================= -->
            <!-- FINGERPRINT -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="118dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👆"
                    android:textSize="32sp" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Vân tay"
                    android:textColor="#6B7280"
                    android:textSize="13sp" />


                <TextView
                    android:id="@+id/tvFingerprintStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="AS608: --"
                    android:textColor="#111827"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />


            <!-- ================================================= -->
            <!-- RFID -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="118dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💳"
                    android:textSize="32sp" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Thẻ RFID"
                    android:textColor="#6B7280"
                    android:textSize="13sp" />


                <TextView
                    android:id="@+id/tvRfidStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="RC522: --"
                    android:textColor="#111827"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- FINGERPRINT MANAGEMENT -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="QUẢN LÝ VÂN TAY"
            android:textColor="#111827"
            android:textSize="16sp"
            android:textStyle="bold" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">


            <!-- SỐ LƯỢNG VÂN TAY -->

            <TextView
                android:id="@+id/tvFingerprintCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Số mẫu vân tay đang lưu: --"
                android:textColor="#374151"
                android:textSize="15sp"
                android:textStyle="bold" />


            <!-- HƯỚNG DẪN -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Mỗi vân tay sử dụng một ID từ 1 đến 127"
                android:textColor="#9CA3AF"
                android:textSize="12sp" />


            <!-- ID INPUT -->

            <EditText
                android:id="@+id/edtFingerprintId"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_input"
                android:hint="Nhập ID vân tay"
                android:inputType="number"
                android:maxLength="3"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#111827"
                android:textColorHint="#9CA3AF"
                android:textSize="15sp" />


            <!-- BUTTON ENROLL / DELETE -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">


                <Button
                    android:id="@+id/btnEnrollFingerprint"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:backgroundTint="#2563EB"
                    android:text="+  ĐĂNG KÝ"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />


                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />


                <Button
                    android:id="@+id/btnDeleteFingerprint"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:backgroundTint="#EF4444"
                    android:text="🗑  XÓA"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- tvMessage giữ ẩn để không ảnh hưởng logic Java -->
        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />




        <!-- ================================================= -->
        <!-- HISTORY -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="LỊCH SỬ MỞ CỬA"
            android:textColor="#111827"
            android:textSize="16sp"
            android:textStyle="bold" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Các lần mở cửa gần nhất"
            android:textColor="#9CA3AF"
            android:textSize="12sp" />


        <LinearLayout
            android:id="@+id/layoutHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📋"
                    android:textSize="28sp" />


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Chưa có lịch sử mở cửa"
                    android:textColor="#6B7280"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- REFRESH -->
        <!-- ================================================= -->

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:backgroundTint="#E5E7EB"
            android:text="↻  LÀM MỚI DỮ LIỆU"
            android:textAllCaps="false"
            android:textColor="#374151"
            android:textSize="14sp"
            android:textStyle="bold" />


        <!-- ================================================= -->
        <!-- FOOTER -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Smart Door • ESP32"
            android:textColor="#9CA3AF"
            android:textSize="11sp" />


    </LinearLayout>

</ScrollView>